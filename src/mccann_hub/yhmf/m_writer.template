 ; Schema-bound flat records and keyed leaf children; qualified scalar inputs only.
 quit
insert(input)
 quit $$write("insert",.input)
replace(input)
 quit $$write("replace",.input)
delete(key)
 new input
 set input(@KEY@)=key
 quit $$write("delete",.input)
inserttx(input)
 quit $$participate("insert",.input)
replacetx(input)
 quit $$participate("replace",.input)
deletetx(key)
 new input
 set input(@KEY@)=key
 quit $$participate("delete",.input)
participate(operation,input)
 new cfg,values,status,key,$etrap
 if '$tlevel quit "transaction"
 set $etrap="if $tlevel trollback"
 set status=$$prepare(operation,.input,.cfg,.values,.key)
 if status'="ok" do stableabort quit status
 set status=$$attempt(operation,key,.values,.cfg)
 if status'="ok" do stableabort
 quit status
write(operation,input)
 new cfg,values,status,key,$etrap
 if $tlevel quit "nested"
 set $etrap="if $tlevel trollback"
 set status=$$prepare(operation,.input,.cfg,.values,.key)
 if status'="ok" quit status
 tstart ():serial
 ; All database-derived state is recreated inside attempt after a restart.
 set status=$$attempt(operation,key,.values,.cfg)
 if status'="ok" do stableabort quit status
 tcommit
 quit "ok"
stableabort
 ; Like NativeStore, expose data-dependent failures only from a stable retry.
 if '$tlevel quit
 if $trestart<3 trestart
 trollback
 quit
prepare(operation,input,cfg,values,key)
 do config(.cfg)
 if $get(cfg("hierarchy")) quit "operation"
 quit $$preflight(operation,.input,.cfg,.values,.key)
preflight(operation,input,cfg,values,key)
 new status
 set status=$$input(operation,.input,.cfg,.values)
 if status'="ok" quit status
 set key=values(cfg("key"))
 if cfg("tag",cfg("key"))="s" set key="s:"_key
 if key[$char(0) quit "invalid_key"
 if cfg("dataOverhead")+(2*$zlength(key))>1019 quit "key_size"
 if operation'="delete",'$$refbound(key,.values,.cfg) quit "key_size"
 quit "ok"
input(operation,input,cfg,values)
 new field,status
 if $data(input)#2 quit "invalid"
 set field="",status="ok"
 for  set field=$order(input(field)) quit:field=""  do  quit:status'="ok"
 . if '$data(cfg("tag",field)) set status="invalid" quit
 . if operation="delete",field'=cfg("key") set status="invalid" quit
 . if operation="patch",field=cfg("key") set status="invalid" quit
 . if $data(cfg("derived",field)) set status="invalid" quit
 . if $data(input(field))'=1 do  quit
 . . if '$get(cfg("nullable",field))!($data(input(field))'=10) set status="invalid" quit
 . . if $data(input(field,"%null"))'=1!(($get(input(field,"%null"))_"x")'="1x") set status="invalid" quit
 . . if $order(input(field,""))'="%null"!($order(input(field,"%null"))'="") set status="invalid" quit
 . . set values(field)="n:"
 . if '$$valid(input(field),field,.cfg) set status="invalid" quit
 . set values(field)=$select($get(cfg("nullable",field)):"v:",1:"")_input(field)
 if status'="ok" quit status
 if operation="delete" quit $select($data(values(cfg("key"))):"ok",1:"invalid")
 if operation="patch" quit $select($data(values):"ok",1:"invalid")
 set field=""
 for  set field=$order(cfg("tag",field)) quit:field=""  if '$data(values(field)) set status="invalid"
 quit status
valid(value,field,cfg,stored)
 new i,good
 if $zlength(value)>32764 quit 0
 if $data(cfg("choicecount",field)),'$$choice(value,field,.cfg) quit 0
 if cfg("tag",field)="r" quit $$refvalid(value,field,.cfg)
 if cfg("tag",field)="d" quit $$dvalid(value,field,.cfg,+$get(stored))
 if (cfg("tag",field)="D")!(cfg("tag",field)="T") quit $$tvalid(value,field,.cfg)
 if cfg("tag",field)="s" do  quit good
 . set good=($length(value)'<cfg("min",field))&($length(value)'>cfg("max",field))
 . for i=1:1:$length(value) if $ascii(value,i)>127 set good=0 quit
 if value'=+value quit 0
 if ($length(value)-($extract(value)="-"))>18 quit 0
 if (value'?1.18N)&(value'?1"-"1.18N) quit 0
 if $data(cfg("ge",field)),value<cfg("ge",field) quit 0
 if $data(cfg("gt",field)),value'>cfg("gt",field) quit 0
 if $data(cfg("le",field)),value>cfg("le",field) quit 0
 if $data(cfg("lt",field)),value'<cfg("lt",field) quit 0
 quit 1
choice(value,field,cfg)
 new ordinal,piece,expected,encoded,good
 set encoded=$$quote(cfg("tag",field)_":"_value),good=0
 for ordinal=1:1:cfg("choicecount",field) do  quit:good
 . set expected="",piece=0
 . for  set piece=$order(cfg("choice",field,ordinal,piece)) quit:piece=""  set expected=expected_cfg("choice",field,ordinal,piece)
 . if encoded=expected set good=1
 quit good
attempt(operation,key,values,cfg,previous)
 new old,field,status,install,root,recordkey
 if '$$available(cfg("global")) quit "maintenance"
 set install=0,root=$get(cfg("address"),$name(@GLOBAL@(key))),recordkey=$get(cfg("recordkey"),key)
 if '$data(^YHMFSchema(cfg("global"))) do  quit:status'="ok" status
 . set status="ok"
 . if $get(cfg("owned")) set status="schema" quit
 . if operation'="insert" set status="schema" quit
 . if $data(@GLOBAL@)!$data(^YHMFIndex(cfg("global")))!$data(^YHMFUnique(cfg("global")))!$data(^YHMFRef(cfg("global"))) set status="unmanaged" quit
 . set install=1
 if 'install,'$$schema(cfg("global"),cfg("fingerprint"),cfg("snapshot")) quit "schema"
 if operation="insert",$data(@root) quit "exists"
 if operation'="insert",'$data(@root) quit "missing"
 if operation'="insert" do  quit:status'="ok" status
 . if $get(@root@(cfg("key")))'=$$scalar(values(cfg("key")),cfg("key"),.cfg) set status="corrupt" quit
 . set status=$$old(root,.cfg,.old)
 if $get(cfg("partial")) do
 . set field=""
 . for  set field=$order(old(field)) quit:field=""  if '$data(values(field)) set values(field)=old(field)
 kill previous
 if operation'="insert" merge previous=old
 if operation="delete",'$get(cfg("owned")) do  quit:status'="ok" status
 . set status=$$incoming(cfg("global"),key)
 ; YHMF writer checkpoint: native tests can pause this attempt before index writes.
 set status=$$indexbefore(operation,recordkey,.values,.old,.cfg)
 if status'="ok" quit status
 set status=$$indexafter(operation,recordkey,.values,.old,.cfg)
 if status'="ok" quit status
 if install set ^YHMFSchema(cfg("global"))=cfg("fingerprint"),^YHMFSchema(cfg("global"),"snapshot")=cfg("snapshot")
 if operation="delete" do  quit status
 . set status=$$refchange(operation,recordkey,.values,.old,.cfg)
 . if status="ok" do
 . . if '$get(cfg("owned")) kill ^YHMFRef(cfg("global"),recordkey)
 . . kill @root
 if operation="insert" do
 . if $get(cfg("owned")) set @root="o:1" quit
 . set field=""
 . for  set field=$order(cfg("meta",field)) quit:field=""  set @root@("%m",field)=cfg("meta",field)
 set field=""
 for  set field=$order(values(field)) quit:field=""  if $get(@root@(field))'=$$scalar(values(field),field,.cfg) set @root@(field)=$$scalar(values(field),field,.cfg)
 quit $$refchange(operation,recordkey,.values,.old,.cfg)
indexbefore(operation,key,values,old,cfg)
 new field,status,token,index,claim,name
 set status="ok",field=""
 for  set field=$order(cfg("index",field)) quit:field=""  do  quit:status'="ok"
 . if operation="insert" quit
 . set name=$get(cfg("indexname",field),field)
 . set token=$$token(old(field),field,.cfg),index=$name(^YHMFIndex(cfg("global"),name,token,key,cfg("digest",field)))
 . set claim="["_$$quote(key)_","_cfg("location",field)_"]"
 . if $data(@index)'=1!($get(@index)'=cfg("location",field)) set status="corrupt" quit
 . if $$hasclaim(old(field),field,.cfg),$get(^YHMFUnique(cfg("global"),name,token))'=claim set status="corrupt" quit
 . if $$hasclaim(old(field),field,.cfg),$data(^YHMFUnique(cfg("global"),name,token))'=1 set status="corrupt" quit
 . if operation="replace",$$token(old(field),field,.cfg)=$$token(values(field),field,.cfg) quit
 . kill @index
 . if $$hasclaim(old(field),field,.cfg) kill ^YHMFUnique(cfg("global"),name,token)
 quit status
indexafter(operation,key,values,old,cfg)
 new field,status,token,index,claim,name
 set status="ok"
 if operation'="delete" do  quit:status'="ok" status
 . set field=""
 . for  set field=$order(cfg("index",field)) quit:field=""  do  quit:status'="ok"
 . . set name=$get(cfg("indexname",field),field)
 . . if operation="replace",$$token(old(field),field,.cfg)=$$token(values(field),field,.cfg) quit
 . . if cfg("tag",field)'="d",cfg("overhead",field)+(2*$zlength(key))+(2*$zlength($$payload(values(field),field,.cfg)))+8>1019 set status="key_size" quit
 . . set token=$$token(values(field),field,.cfg)
 . . if cfg("overhead",field)+(2*$zlength(key))+(2*$zlength(token))>1019 set status="key_size" quit
 . . set claim="["_$$quote(key)_","_cfg("location",field)_"]"
 . . if $$hasclaim(values(field),field,.cfg),$data(^YHMFUnique(cfg("global"),name,token)) set status="unique" quit
 . . if $data(^YHMFIndex(cfg("global"),name,token,key,cfg("digest",field))) set status="corrupt" quit
 . . set ^YHMFIndex(cfg("global"),name,token,key,cfg("digest",field))=cfg("location",field)
 . . if $$hasclaim(values(field),field,.cfg) set ^YHMFUnique(cfg("global"),name,token)=claim
 quit status
old(root,cfg,values)
 new field,part,raw,status,count
 set status="ok"
 if $get(cfg("owned")) set status=$select($get(@root)="o:1":"ok",1:"corrupt")
 else  set status=$$recordmeta(root,.cfg)
 if status'="ok" quit status
 set field=""
 for  set field=$order(@root@(field)) quit:field=""  do  quit:status'="ok"
 . if field="%m",'$get(cfg("owned")) quit
 . if $data(cfg("tag",field)) quit
 . if '$data(cfg("children",field)) set status="corrupt" quit
 . set status=$$hcount($name(@root@(field)),.cfg,field,.count)
 . if status="ok",(count>0)'=($order(@root@(field,""))'="") set status="corrupt"
 set field=""
 for  set field=$order(cfg("children",field)) quit:field=""  if '$data(@root@(field)) set status="corrupt"
 if status'="ok" quit status
 set field=""
 for  set field=$order(cfg("tag",field)) quit:field=""  do  quit:status'="ok"
 . if $data(@root@(field))'=1 set status="corrupt" quit
 . set raw=@root@(field)
 . if $get(cfg("nullable",field)),raw="n:" set values(field)="n:" quit
 . if $extract(raw,1,2)'=(cfg("tag",field)_":") set status="corrupt" quit
 . set part=$extract(raw,3,$length(raw))
 . if cfg("tag",field)="r",cfg("targets",cfg("ref",field),"keytag")="s" do  quit:status'="ok"
 . . if $extract(part,1,2)'="s:" set status="corrupt" quit
 . . set part=$extract(part,3,$length(part))
 . set status=$$storedscalar(part,field,.cfg)
 . if status'="ok" quit
 . set values(field)=$select($get(cfg("nullable",field)):"v:",1:"")_part
 quit status
storedscalar(value,field,cfg)
 new tag,magnitude,number,index,ascii
 if $zlength(value)>32764 quit "unsupported"
 set tag=cfg("tag",field)
 if tag="r" set tag=cfg("targets",cfg("ref",field),"keytag")
 if tag="s",'$$utf8(value) quit "corrupt"
 if tag="s" do  quit:'ascii "unsupported"
 . set ascii=1
 . for index=1:1:$zlength(value) if $zascii(value,index)>127 set ascii=0 quit
 if tag="i" do  quit:magnitude="invalid" "corrupt"
 . set magnitude=$extract(value,1+($extract(value)="-"),$length(value))
 . if '$$natural(magnitude)!(value="-0") set magnitude="invalid"
 if tag="i",$length(magnitude)>18 quit "unsupported"
 if tag="d",'$$decimal(value,.number) quit $select($get(number("outside")):"unsupported",1:"corrupt")
 if cfg("tag",field)="r",value[$char(0) quit "unsupported"
 quit $select($$valid(value,field,.cfg,1):"ok",1:"corrupt")
hasclaim(value,field,cfg)
 quit cfg("unique",field)&'($get(cfg("nullable",field))&(value="n:"))
payload(value,field,cfg)
 quit $select($get(cfg("nullable",field)):$extract(value,3,$length(value)),1:value)
token(value,field,cfg)
 if $get(cfg("nullable",field)),value="n:" quit "v:"_$$quote("n:")
 if cfg("tag",field)="d" quit "v:"_$$quote($$dtoken($$payload(value,field,.cfg)))
 quit "v:"_$$quote($$scalar(value,field,.cfg))
scalar(value,field,cfg)
 if $get(cfg("nullable",field)),value="n:" quit "n:"
 set value=$$payload(value,field,.cfg)
 if cfg("tag",field)="r" quit "r:"_$$refkey(value,field,.cfg)
 quit cfg("tag",field)_":"_value
quote(value)
 new out,i,code,char
 set out=$char(34)
 for i=1:1:$length(value) do
 . set char=$extract(value,i),code=$ascii(char)
 . if (code=34)!(code=92) set out=out_$char(92)_char quit
 . if code=8 set out=out_"\b" quit
 . if code=9 set out=out_"\t" quit
 . if code=10 set out=out_"\n" quit
 . if code=12 set out=out_"\f" quit
 . if code=13 set out=out_"\r" quit
 . if (code<32)!(code=127) set out=out_"\u00"_$extract("0123456789abcdef",(code\16)+1)_$extract("0123456789abcdef",(code#16)+1) quit
 . set out=out_char
 quit out_$char(34)
