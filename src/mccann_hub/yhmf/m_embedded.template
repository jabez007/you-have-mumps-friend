 ; Complete embedded writes reuse the same per-owner attempt/index/reference path.
ninput(path)
 if $data(@path)'=10 quit 0
 if $data(@path@("%null"))'=1 quit 0
 if ($get(@path@("%null"))_"x")'="1x" quit 0
 quit ($order(@path@(""))="%null")&($order(@path@("%null"))="")
eshape(path,nullable)
 if $get(nullable),$get(@path)="n:" quit $select($data(@path)=1:"ok",1:"corrupt")
 quit $select($get(@path)="o:1":"ok",1:"corrupt")
ewidth(values,cfg)
 quit $$ewidthnode($name(values),.cfg)
ewidthnode(source,cfg)
 new field,childcfg,width
 if '$get(cfg("variable")) quit cfg("width")
 set field="",width=cfg("basewidth")
 for  set field=$order(cfg("embedded",field)) quit:field=""  do
 . if $get(@source@(field))="n:" quit
 . kill childcfg
 . merge childcfg=cfg("nodes",cfg("embedded",field)),childcfg("nodes")=cfg("nodes")
 . set width=width+$$ewidthnode($name(@source@(field)),.childcfg)
 quit width
echange(operation,root,values,cfg,recordkey)
 new field,parts,depth,childcfg,childvalues,status,name,maximum,oldnull,newnull,childop
 if $get(cfg("partial")) quit "ok"
 if '$data(cfg("embedded")) quit "ok"
 merge parts=cfg("parts")
 set parts(0)=recordkey,depth=$order(parts(""),-1),field="",status="ok"
 for  set field=$order(cfg("embedded",field)) quit:field=""  do  quit:status'="ok"
 . set parts(depth+1)=field
 . kill childcfg,childvalues
 . do hconfig(.cfg,cfg("embedded",field),.parts,.childcfg)
 . set childcfg("address")=$name(@root@(field)),maximum=0,name="",oldnull=0,newnull=0,childop=operation
 . if '$$hbound(cfg("global"),.parts,0) set status="key_size" quit
 . if operation'="insert" set oldnull=($get(@root@(field))="n:")
 . if operation'="delete" set newnull=($get(values(field))="n:")
 . if oldnull,newnull quit
 . if operation="delete",oldnull kill @root@(field) quit
 . if newnull,operation="insert" set @root@(field)="n:" quit
 . if newnull set childop="delete"
 . if oldnull kill @root@(field) set childop="insert"
 . for  set name=$order(childcfg("tag",name)) quit:name=""  do  quit:status'="ok"
 . . if $zlength(name)>maximum set maximum=$zlength(name)
 . . if $data(childcfg("index",name))!$data(childcfg("ref",name)) set status=$$hwhere(.parts,depth+1,name,.childcfg)
 . if status'="ok" quit
 . if '$$hbound(cfg("global"),.parts,maximum) set status="key_size" quit
 . if childop'="delete" merge childvalues=values(field)
 . if childop'="delete",'$$refbound(recordkey,.childvalues,.childcfg) set status="key_size" quit
 . set status=$$attempt(childop,recordkey,.childvalues,.childcfg)
 . if status="ok",newnull set @root@(field)="n:"
 ; YHMF embedded changes complete: all descendants await caller commit.
 quit status
